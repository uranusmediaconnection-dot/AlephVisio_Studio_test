# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (optional - app automatically uses built-in in-memory fallback if omitted).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alephvisio"

# APP_ENCRYPTION_KEY: Secret key used to encrypt API credentials stored in settings.
APP_ENCRYPTION_KEY="your-encryption-secret-key-here"

# Model Router API Keys (can also be entered dynamically via the Settings UI)
OPENROUTER_API_KEY=""
KILOCODE_API_KEY=""
KILOCODE_BASE_URL="https://api.kilo.ai/api/gateway"
NEXT_PUBLIC_APP_NAME="AlephVisio Studio"
